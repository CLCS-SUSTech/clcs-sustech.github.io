---
import Cse5026ReadingsPage from '@/components/pages/Cse5026ReadingsPage.astro';
import { languages, type Lang } from '@/lib/paths';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang }, props: { lang } }));
}

interface Props { lang: Lang }
const { lang } = Astro.props;
---

<Cse5026ReadingsPage lang={lang} />
