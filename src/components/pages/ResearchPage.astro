---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SimplePageHeader from '@/components/SimplePageHeader.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import PublicationItem from '@/components/PublicationItem.astro';
import type { Lang } from '@/lib/paths';

interface Props { lang: Lang }
const { lang } = Astro.props;
const projects = (await getCollection('projects'))
  .sort((a, b) => a.data.order - b.data.order);
const publications = (await getCollection('publications'))
  .sort((a, b) => b.data.year - a.data.year
    || Number(b.data.featured) - Number(a.data.featured)
    || a.data.title.localeCompare(b.data.title));
const publicationYears = [...new Set(publications.map((entry) => entry.data.year))];
---

<BaseLayout lang={lang} title={lang === 'zh' ? '研究与发表' : 'Research & Publications'}>
  <SimplePageHeader title={lang === 'zh' ? '研究与发表' : 'Research & Publications'} />

  <section class="content-section">
    <div class="container">
      <div class="section-intro">
        <h2>{lang === 'zh' ? '最近项目' : 'Recent Projects'}</h2>
      </div>
      <div class="project-grid">
        {projects.map((entry) => <ProjectCard entry={entry} lang={lang} />)}
      </div>
    </div>
  </section>

  <section class="content-section publications-section">
    <div class="container">
      <div class="section-intro publication-heading">
        <h2>{lang === 'zh' ? '发表物' : 'Publications'}</h2>
      </div>
      <div class="publication-years">
        {publicationYears.map((year) => (
          <section class="publication-year-group" aria-labelledby={`year-${year}`}>
            <h3 id={`year-${year}`}>{year}</h3>
            <div>
              {publications
                .filter((entry) => entry.data.year === year)
                .map((entry) => <PublicationItem entry={entry} lang={lang} showYear={false} />)}
            </div>
          </section>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .content-section {
    padding: clamp(52px, 7vw, 84px) 0;
  }

  .content-section + .content-section {
    border-top: 1px solid var(--line);
  }

  .section-intro {
    margin-bottom: 30px;
  }

  .section-intro h2 {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(1.55rem, 2.5vw, 2rem);
    font-weight: 500;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  .publications-section {
    background: var(--paper-deep);
  }

  .publication-heading {
    display: block;
  }

  .publication-year-group {
    display: grid;
    grid-template-columns: 100px minmax(0, 1fr);
    gap: clamp(28px, 5vw, 64px);
  }

  .publication-year-group + .publication-year-group {
    margin-top: 34px;
  }

  .publication-year-group > h3 {
    margin: 0;
    padding-top: 26px;
    color: var(--brand);
    font-family: var(--sans);
    font-size: 0.92rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 760px) {
    .project-grid {
      grid-template-columns: 1fr;
    }

    .publication-year-group {
      grid-template-columns: 1fr;
      gap: 4px;
    }

    .publication-year-group > h3 {
      padding-top: 0;
    }
  }
</style>
