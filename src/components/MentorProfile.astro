---
import type { CollectionEntry } from 'astro:content';
import { lab, memberRoleLabels } from '@/data/site';
import { localized } from '@/lib/i18n';
import { type Lang, withBase } from '@/lib/paths';

interface Props {
  entry: CollectionEntry<'member'>;
  lang: Lang;
}

const { entry, lang } = Astro.props;
const mentor = entry.data;
const nameZh = localized(mentor.name, 'zh');
const nameEn = localized(mentor.name, 'en');
const role = memberRoleLabels[lang].pi;
const academicTitle = mentor.academicTitle
  ? localized(mentor.academicTitle, lang)
  : (lang === 'zh' ? lab.mentorAcademicTitleZh : lab.mentorAcademicTitleEn);
const bio = mentor.bio ? localized(mentor.bio, lang) : undefined;
const recruiting = mentor.recruiting ? localized(mentor.recruiting, lang) : undefined;
---

<article class="mentor-profile">
  <div class="mentor-photo">
    {mentor.avatar
      ? <img src={withBase(mentor.avatar)} alt={`${nameZh} ${nameEn}`} />
      : <span>{nameZh.slice(0, 2)}</span>}
  </div>

  <div class="mentor-content">
    <header>
      <!-- <span class="mentor-label">{lang === 'zh' ? '导师' : 'Mentor'}</span> -->
      <h2>
        {nameZh}
        <small>{nameEn}</small>
      </h2>
      <p class="mentor-role">{role}</p>
    </header>

    <p class="mentor-position">
      {academicTitle}, <a href={lab.universityUrl} target="_blank" rel="noreferrer">
        {lang === 'zh' ? lab.universityZh : lab.universityEn}
      </a>, <a href={lab.departmentUrl} target="_blank" rel="noreferrer">
        {lang === 'zh' ? lab.departmentZh : lab.departmentEn}
      </a>
    </p>

    {bio && <p class="mentor-bio">{bio}</p>}

    <div class="mentor-links" aria-label={lang === 'zh' ? '个人资料链接' : 'Profile links'}>
      <div class="mentor-link-row mentor-cv-links">
        <a href={withBase(lab.mentorCvUrl)} target="_blank" rel="noreferrer">CV</a>
        <span aria-hidden="true">/</span>
        <a href={withBase(lab.mentorCvZhUrl)} target="_blank" rel="noreferrer">中文简历</a>
      </div>
      <div class="mentor-link-row mentor-profile-links">
        {mentor.profileLinks.map((link) => (
          <a href={link.url} target="_blank" rel="noreferrer">{link.label}</a>
        ))}
      </div>
    </div>

    {recruiting && <p class="recruiting">{recruiting}</p>}
  </div>
</article>

<style>
  .mentor-profile {
    display: grid;
    grid-template-columns: minmax(180px, 230px) minmax(0, 1fr);
    gap: clamp(36px, 7vw, 86px);
    align-items: start;
    padding: clamp(34px, 5vw, 58px) 0;
    border-top: 1px solid var(--line-strong);
    border-bottom: 1px solid var(--line);
  }

  .mentor-photo {
    display: grid;
    place-items: center;
    width: 100%;
    /*aspect-ratio: 2 / 3;*/
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: var(--paper-deep);
    color: var(--brand);
    font-family: var(--serif);
    font-size: 1.5rem;
  }

  .mentor-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /*object-fit: content;*/
  }

  .mentor-label {
    color: var(--brand);
    font-size: 0.76rem;
  }

  h2 {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 14px;
    margin: 8px 0 4px;
    font-family: var(--serif);
    font-size: clamp(1.4rem, 2.4vw, 2rem);
    font-weight: 500;
    line-height: 1.2;
  }

  h2 small {
    color: var(--ink);
    font-family: var(--sans);
    font-size: 0.75em;
    font-weight: 400;
  }

  .mentor-role,
  .mentor-position,
  .mentor-bio,
  .recruiting {
    color: var(--ink-soft);
  }

  .mentor-role {
    margin: 0;
    font-size: 1.0rem;
  }

  .mentor-position {
    margin: 24px 0 0;
    line-height: 1.7;
  }

  .mentor-position a {
    color: var(--brand);
    text-decoration: none;
  }

  .mentor-bio {
    max-width: 720px;
    margin: 19px 0 0;
    line-height: 1.75;
  }

  .mentor-links {
    display: grid;
    gap: 8px;
    margin-top: 24px;
    font-family: var(--sans);
    font-size: 0.88rem;
  }

  .mentor-link-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0;
  }

  .mentor-cv-links {
    flex-wrap: nowrap;
    gap: 5px;
    white-space: nowrap;
  }

  .mentor-profile-links a + a {
    margin-left: 20px;
  }

  .mentor-links a {
    color: var(--brand);
    text-decoration: none !important;
  }

  .mentor-links a:hover {
    color: var(--brand-deep);
  }

  .mentor-position a:hover {
    color: var(--brand-deep);
  }

  .recruiting {
    max-width: 760px;
    margin: 28px 0 0;
    padding: 15px 18px;
    border-left: 3px solid var(--accent);
    background: rgb(255 255 255 / 50%);
    font-size: 0.9rem;
  }

  @media (max-width: 640px) {
    .mentor-profile {
      grid-template-columns: 100px minmax(0, 1fr);
      gap: 22px;
    }

    .mentor-photo {
      aspect-ratio: 3 / 4;
    }

    .mentor-position,
    .mentor-bio,
    .mentor-links,
    .recruiting {
      grid-column: 1 / -1;
    }

    .mentor-content {
      display: contents;
    }

    .mentor-content header {
      align-self: center;
    }

    .mentor-position {
      margin-top: 2px;
    }


  }
</style>
