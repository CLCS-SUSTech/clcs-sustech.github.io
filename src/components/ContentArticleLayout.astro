---
import BaseLayout from '@/layouts/BaseLayout.astro';
import type { Lang } from '@/lib/paths';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  meta?: string;
  backHref: string;
  backLabel: string;
  alternateLangPath?: string;
}

const { lang, title, description, meta, backHref, backLabel, alternateLangPath } = Astro.props;
---

<BaseLayout lang={lang} title={title} description={description} alternateLangPath={alternateLangPath}>
  <article class="content-article">
    <header class="article-header">
      <div class="article-column">
        <a class="back-link" href={backHref}>← {backLabel}</a>
        {meta && <span class="article-meta">{meta}</span>}
        <h1>{title}</h1>
        {description && <p class="article-summary">{description}</p>}
      </div>
    </header>
    <div class="article-content">
      <div class="article-column prose">
        <slot />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .article-column {
    width: min(calc(100% - 40px), 780px);
    margin-inline: auto;
  }

  .article-header {
    padding: clamp(38px, 5vw, 56px) 0 clamp(32px, 4vw, 46px);
  }

  .back-link {
    display: inline-block;
    margin-bottom: 26px;
    color: var(--ink-soft);
    font-size: 0.82rem;
  }

  .article-meta {
    display: block;
    color: var(--brand);
    font-size: 0.76rem;
  }

  h1 {
    max-width: 760px;
    margin: 10px 0 14px;
    font-family: var(--serif);
    font-size: clamp(1.9rem, 3.5vw, 2.85rem);
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.18;
  }

  .article-summary {
    max-width: 650px;
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.96rem;
    line-height: 1.7;
  }

  .article-content {
    padding: clamp(38px, 5vw, 56px) 0 clamp(72px, 9vw, 104px);
    border-top: 1px solid var(--line);
    background: rgb(255 255 255 / 24%);
  }

  .article-content :global(p:first-child) {
    margin-top: 0;
  }

  @media (max-width: 720px) {
    .article-column {
      width: min(calc(100% - 28px), 780px);
    }
  }
</style>
