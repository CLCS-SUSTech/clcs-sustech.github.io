---
import type { CollectionEntry } from 'astro:content';
import { localized } from '@/lib/i18n';
import type { Lang } from '@/lib/paths';
import { langPath } from '@/lib/paths';

interface Props {
  entry: CollectionEntry<'research'>;
  lang: Lang;
}

const { entry, lang } = Astro.props;
const title = localized(entry.data.title, lang);
const summary = localized(entry.data.summary, lang);
const keywords = localized(entry.data.keywords, lang);
---

<article class="research-card">
  <span class="eyebrow">RESEARCH · {String(entry.data.order).padStart(2, '0')}</span>
  <h3>{title}</h3>
  <p>{summary}</p>
  <div class="keywords">
    {keywords.slice(0, 3).map((keyword) => <span>{keyword}</span>)}
  </div>
  <a class="arrow-link" href={`${langPath(lang, 'research')}#${entry.data.slug}`}>
    {lang === 'zh' ? '相关研究' : 'Related work'}
  </a>
</article>

<style>
  .research-card {
    display: flex;
    flex-direction: column;
    min-height: 330px;
    padding: 30px;
    border: 1px solid var(--line);
    background: rgb(255 255 255 / 62%);
    transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
  }

  .research-card:hover {
    border-color: var(--line-strong);
    box-shadow: var(--shadow);
    transform: translateY(-4px);
  }

  h3 {
    margin: 24px 0 12px;
    font-family: var(--sans);
    font-size: clamp(1.4rem, 2.4vw, 2rem);
    font-weight: 600;
    line-height: 1.25;
  }

  p {
    margin: 0;
    color: var(--ink-soft);
  }

  .keywords {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 22px 0;
  }

  .keywords span {
    padding: 3px 8px;
    border: 1px solid var(--line);
    color: var(--ink-soft);
    font-size: 0.72rem;
  }

  .arrow-link {
    margin-top: auto;
  }

  @media (max-width: 720px) {
    .research-card {
      min-height: 0;
    }
  }
</style>
