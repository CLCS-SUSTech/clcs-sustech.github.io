---
import '@/styles/global.css';
import { copy, lab, siteFeatures } from '@/data/site';
import { languages, localeConfig } from '@/lib/i18n';
import { langPath, type Lang, withBase } from '@/lib/paths';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  alternateLangPath?: string;
}

const { lang, title, description, alternateLangPath } = Astro.props;
const t = copy[lang];
const pageTitle = title ? `${title} · ${lab.nameZh}` : `${lab.nameZh} · ${lab.nameEn}`;
const currentPath = Astro.url.pathname;
const currentLanguageIndex = languages.indexOf(lang);
const otherLang = languages[(currentLanguageIndex + 1) % languages.length];
const otherLangPath = alternateLangPath
  ?? currentPath.replace(new RegExp(`/${lang}(?=/|$)`), `/${otherLang}`);

type NavKey = keyof typeof t.nav;
const navItems: Array<{ key: NavKey; href: string }> = [
  { key: 'home', href: langPath(lang) },
  { key: 'research', href: langPath(lang, 'research') },
  { key: 'news', href: langPath(lang, 'news') },
  { key: 'members', href: langPath(lang, 'members') },
];
if (siteFeatures.join) navItems.push({ key: 'join', href: langPath(lang, 'join') });

function isActive(href: string, key: string) {
  if (key === 'home') return currentPath === href;
  return currentPath.startsWith(href);
}
---

<!doctype html>
<html lang={localeConfig[lang].htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description ?? t.siteDescription} />
    <meta name="theme-color" content="#fbfaf7" />
    <link rel="icon" type="image/png" href={withBase('brand/favicon.png')} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{lang === 'zh' ? '跳到主要内容' : 'Skip to main content'}</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="site-brand" href={langPath(lang)} aria-label={`${lab.nameZh} · ${lab.nameEn}`}>
          <img class="brand-logo" src={withBase('brand/favicon.png')} alt="" aria-hidden="true" />
          <span>
            <strong>{lab.nameZh}</strong>
            <small>{lab.nameEn}</small>
          </span>
        </a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-navigation">
          <span>{lang === 'zh' ? '菜单' : 'Menu'}</span>
          <span class="menu-icon" aria-hidden="true"></span>
        </button>
        <nav id="site-navigation" class="site-nav" aria-label={lang === 'zh' ? '主导航' : 'Main navigation'}>
          {navItems.map((item) => (
            <a class:list={[{ active: isActive(item.href, item.key) }]} href={item.href}>
              {t.nav[item.key]}
            </a>
          ))}
          <a class="language-link" href={otherLangPath} hreflang={otherLang}>
            {localeConfig[otherLang].switchLabel}
          </a>
        </nav>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-grid">
        <div>
          <strong>{lab.nameZh}</strong>
          <span class="footer-lab-name-en">{lab.nameEn}</span>
          <p>{t.footerNote}</p>
        </div>
        <div>
          <span class="footer-label">{lang === 'zh' ? '联系' : 'Contact'}</span>
          <p>{lab.email}<br />{lang === 'zh' ? lab.locationZh : lab.locationEn}</p>
        </div>
        <div>
          <span class="footer-label">{lang === 'zh' ? '所属' : 'Affiliation'}</span>
          <p class="footer-affiliation">
            <a href={lab.departmentUrl} target="_blank" rel="noreferrer">
              {lang === 'zh' ? lab.departmentZh : lab.departmentEn}
            </a><br />
            <a href={lab.universityUrl} target="_blank" rel="noreferrer">
              {lang === 'zh' ? lab.universityZh : lab.universityEn}
            </a>
          </p>
        </div>
      </div>
      <div class="container footer-bottom">
        <span>© {new Date().getFullYear()} {lab.nameZh}</span>
        <!-- <span>{lang === 'zh' ? '静态网站 · GitHub Pages' : 'Static site · GitHub Pages'}</span> -->
      </div>
    </footer>

    <script>
      const menuButton = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const navigation = document.querySelector<HTMLElement>('.site-nav');

      menuButton?.addEventListener('click', () => {
        const isOpen = menuButton.getAttribute('aria-expanded') === 'true';
        menuButton.setAttribute('aria-expanded', String(!isOpen));
        navigation?.classList.toggle('open', !isOpen);
      });
    </script>
  </body>
</html>

<style>
  .site-header {
    position: relative;
    z-index: 20;
    border-top: 4px solid var(--accent);
    border-bottom: 1px solid var(--line);
    background: rgb(251 250 247 / 92%);
    backdrop-filter: blur(14px);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 84px;
    gap: 24px;
  }

  .site-brand {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 330px;
    color: var(--ink);
    text-decoration: none;
  }

  .brand-logo {
    flex: 0 0 auto;
    width: 50px;
    height: 50px;
    object-fit: contain;
  }

  .site-brand strong,
  .site-brand small {
    display: block;
  }

  .site-brand strong {
    font-family: var(--serif);
    font-size: 0.98rem;
    font-weight: 500;
    line-height: 1.25;
  }

  .site-brand small {
    max-width: 310px;
    margin-top: 3px;
    color: var(--ink-soft);
    font-size: 0.66rem;
    line-height: 1.3;
  }

  .site-nav {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: clamp(10px, 1.6vw, 24px);
  }

  .site-nav a {
    position: relative;
    color: var(--ink-soft);
    font-size: 0.88rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  .site-nav a::after {
    position: absolute;
    right: 0;
    bottom: -8px;
    left: 0;
    height: 2px;
    background: var(--brand);
    content: '';
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 160ms ease;
  }

  .site-nav a:hover,
  .site-nav a.active {
    color: var(--ink);
  }

  .site-nav a:hover::after,
  .site-nav a.active::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .site-nav .language-link {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border: 1px solid var(--line-strong);
    color: var(--ink);
  }

  .site-nav .language-link::after {
    display: none;
  }

  .menu-toggle {
    display: none;
  }

  .site-footer {
    padding: 58px 0 24px;
    border-top: 1px solid var(--line);
    background: var(--ink);
    color: rgb(255 255 255 / 82%);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr;
    gap: 48px;
  }

  .footer-grid strong {
    color: var(--white);
    font-family: var(--serif);
    font-size: 1.5rem;
    font-weight: 500;
  }

  .footer-lab-name-en {
    display: block;
    margin-top: 4px;
    color: rgb(255 255 255 / 72%);
    font-family: var(--sans);
    font-size: 0.86rem;
  }

  .footer-grid p {
    margin: 10px 0 0;
    font-size: 0.9rem;
  }

  .footer-affiliation a {
    color: inherit;
    text-decoration-color: rgb(255 255 255 / 32%);
  }

  .footer-affiliation a:hover {
    color: var(--white);
    text-decoration-color: currentColor;
  }

  .footer-label {
    color: var(--white);
    font-family: var(--sans);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    margin-top: 52px;
    padding-top: 18px;
    border-top: 1px solid rgb(255 255 255 / 16%);
    font-size: 0.76rem;
  }

  @media (max-width: 800px) {
    .menu-toggle {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 8px 0;
      border: 0;
      background: transparent;
      color: var(--ink);
      cursor: pointer;
      font-weight: 600;
    }

    .menu-icon,
    .menu-icon::before,
    .menu-icon::after {
      display: block;
      width: 22px;
      height: 1px;
      background: currentColor;
      content: '';
    }

    .menu-icon {
      position: relative;
    }

    .menu-icon::before {
      position: absolute;
      top: -6px;
    }

    .menu-icon::after {
      position: absolute;
      top: 6px;
    }

    .site-nav {
      position: absolute;
      right: 0;
      top: 100%;
      left: 0;
      display: none;
      align-items: stretch;
      padding: 20px;
      border-bottom: 1px solid var(--line);
      background: var(--paper);
      box-shadow: var(--shadow);
    }

    .site-nav.open {
      display: grid;
    }

    .site-nav a {
      padding: 9px 0;
    }

    .site-nav a::after {
      display: none;
    }

    .site-nav .language-link {
      margin-top: 8px;
      padding: 0;
    }
  }

  @media (max-width: 720px) {
    .site-brand {
      min-width: 0;
    }

    .brand-logo {
      width: 44px;
      height: 44px;
    }

    .site-brand strong {
      font-size: 0.86rem;
    }

    .site-brand small {
      font-size: 0.58rem;
    }

    .footer-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .footer-bottom {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (max-width: 440px) {
    .header-inner {
      gap: 10px;
    }

    .brand-logo {
      width: 38px;
      height: 38px;
    }

    .site-brand {
      gap: 8px;
    }

    .site-brand strong {
      font-size: 0.75rem;
    }

    .site-brand small {
      font-size: 0.52rem;
    }

    .menu-toggle > span:first-child {
      display: none;
    }
  }
</style>
